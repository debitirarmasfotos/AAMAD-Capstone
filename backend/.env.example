# Backend runtime configuration for the PMO Program Intelligence Crew.
# Copy to .env and fill in a real key locally. NEVER commit real secrets.

# Required for the Narrative LLM step. Without a real key the Narrative step
# fails closed and POST /api/runs returns 503 missing_api_key.
OPENAI_API_KEY=sk-your-key-here

# Model + runtime controls for the Narrative crew (low/zero temperature is set
# in code for reproducibility).
OPENAI_MODEL=gpt-4o

# Runtime selection (recorded in backend.md Audit).
AAMAD_TARGET_RUNTIME=crewai

# Disable CrewAI telemetry for a clean, deterministic local build.
CREWAI_TELEMETRY_OPT_OUT=true

# Logging verbosity for the API.
LOG_LEVEL=INFO
